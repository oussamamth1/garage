rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
      match /orders/{orderId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.technicianId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.technicianId == request.auth.uid;
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /motoTypes/{typeId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid
      );
      allow delete: if false;
    }

    match /conversations/{convId} {
      allow read, update, delete: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.technicianId == request.auth.uid
      );
      match /messages/{messageId} {
        allow read, write: if isSignedIn()
          && exists(/databases/$(database)/documents/conversations/$(convId))
          && (
            get(/databases/$(database)/documents/conversations/$(convId)).data.clientId == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(convId)).data.technicianId == request.auth.uid
          );
      }
    }
  }
}
